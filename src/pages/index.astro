---
import RootLayout from "../layouts/RootLayout.astro";
import { Icon } from "astro-icon/components";
import Gravatar from '../components/Gravatar.astro';
import config from "../config.ts";

const posts = Object.values(import.meta.glob("./blog/_posts/**/*.mdx", { eager: true }));

const sortedPosts = posts.sort((a, b) => {
    return new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
});

const groupedPosts = sortedPosts.reduce((acc, post) => {
    const year = new Date(post.frontmatter.date).getFullYear();

    if (!acc[year]) {
        acc[year] = [];
    }

    acc[year].push(post);
    return acc;
}, {});

const years = Object.keys(groupedPosts).sort((a, b) => b - a);
---

<RootLayout title="Blog">
    <section class="bg-base-200/50 rounded-3xl p-8 mb-12 border border-base-content/5">
        <div class="flex flex-col md:flex-row items-center gap-8">
            <div class="avatar">
                <div class="w-24 h-24 rounded-full ring ring-primary ring-offset-base-100 ring-offset-4">
                    <Gravatar email={config.author.email} />
                </div>
            </div>

            <div class="flex-1 text-center md:text-left">
                <h2 class="text-3xl font-bold text-base-content mb-2">
                    Hey, I'm <span class="font-bold text-primary">{config.author.name}</span> <span class="inline-block animate-bounce">👋</span>
                </h2>
                <p class="text-lg text-base-content/70 mb-6 max-w-2xl leading-relaxed">
                    {config.intro}
                </p>

                <div class="flex flex-wrap justify-center md:justify-start gap-4">
                    <a href={`https://x.com/${config.social.xcom}`} target="_blank" class="btn btn-sm btn-outline gap-2 border-base-content/20">
                        <Icon name="fa7-brands:x-twitter" class="w-4 h-4" />
                        Follow
                    </a>
                    <a href={`https://github.com/${config.social.github}`} target="_blank" class="btn btn-sm btn-outline gap-2 border-base-content/20">
                        <Icon name="fa7-brands:github" class="w-4 h-4" />
                        Projects
                    </a>
                    <a href={config.urls.support} target="_blank" class="btn btn-soft btn-primary btn-sm gap-2">
                        <Icon name="heroicons:heart" class="w-4 h-4" />
                        Support my work
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="my-8">
        {years.map(year => (
            /* Use a Fragment to wrap the multiple child elements */
            <Fragment key={year}>
                <div class="w-full flex mb-4">
                    <div class="w-16"></div>
                    <h2 class="grow text-3xl font-bold">{year}</h2>
                </div>

                {groupedPosts[year].map((post) => {
                    const date = new Date(post.frontmatter.date);
                    const slug = post.file.split('/').pop().replace(/\.mdx$/, '');

                    return (
                        <div class="w-full flex mb-4 items-center" key={slug}>
                            <div class="min-w-16 opacity-50">
                                {date.toLocaleDateString('en-US', { month: 'short', day: '2-digit' })}
                            </div>

                            <a href={`/blog/${post.slug ?? slug}`} class="link-primary">
                                {post.frontmatter.title}
                            </a>
                        </div>
                    );
                })}
            </Fragment>
        ))}
    </section>
</RootLayout>
