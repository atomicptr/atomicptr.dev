---
import PostsList from "../../components/PostsList.astro";
import RootLayout from "../../layouts/RootLayout.astro";
import { Icon } from "astro-icon/components";
import { SEO } from "astro-seo";
import type { Post } from "../../types";

import config from "../../config.ts";

export async function getStaticPaths() {
    const posts: Post[] = Object.values(
        import.meta.glob("../blog/_posts/**/*.mdx", { eager: true }),
    );

    const uniqueTags = [
        ...new Set(posts.map((post: Post) => post.frontmatter.tags).flat()),
    ];

    return uniqueTags.map((tag) => {
        const filteredPosts = posts.filter((post) =>
            post.frontmatter.tags.includes(tag),
        );
        return {
            params: { tag },
            props: { posts: filteredPosts },
        };
    });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<RootLayout title={`#${tag}`}>
    <SEO slot="head"
        title={`#${tag} | ${config.title}`}
        description={`Posts tagged with #${tag}`}
        canonical={canonicalURL}
        openGraph={{
            basic: {
                title: `Posts tagged: #${tag}`,
                type: "website",
                image: new URL("/social.jpg", Astro.site).toString(),
            }
        }}
        twitter={{
            creator: `@${config.social.xcom}`,
            card: "summary_large_image",
        }}
    />
    <a href="/" class="btn btn-ghost btn-xs mt-12">
        <Icon name="heroicons:chevron-left" />
        Back
    </a>

    <h1 class="text-3xl font-semibold mt-12 mb-6">
        #{tag}
    </h1>

    <PostsList posts={posts} />
</RootLayout>
