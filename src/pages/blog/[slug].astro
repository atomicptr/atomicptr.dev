---
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import type { Post } from "../../types";

export async function getStaticPaths() {
    const posts: Post[] = Object.values(
        import.meta.glob("./_posts/**/*.mdx", {
            eager: true,
        }),
    );

    return posts.map((post: Post) => {
        const slug = post.file
            .split("/")
            .pop()!
            .replace(/\.mdx$/, "");

        return {
            params: {
                slug: post.slug ?? slug,
            },
            props: { post },
        };
    });
}

const post = Astro.props.post as any;
const Content = post.Content ?? post.default ?? null;
---

<BlogPostLayout {...post}>
    <Content />
</BlogPostLayout>

