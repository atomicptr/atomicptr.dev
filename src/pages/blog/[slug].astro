---
import BlogPostLayout from "@src/layouts/BlogPostLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog");

    return posts.map((entry) => {
        const slug =
            entry.filePath?.split("/").pop()!.split(".").shift()! ?? "";

        return {
            params: { slug },
            props: { entry, slug, filePath: entry.filePath },
        };
    });
}

const { entry, slug, filePath } = Astro.props;
const { Content } = await render(entry);
---

<BlogPostLayout {slug} file={filePath} frontmatter={entry.data}>
    <Content />
</BlogPostLayout>

