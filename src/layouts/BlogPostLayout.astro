---
import Comments from "@src/components/Comments.astro";
import Gravatar from "@src/components/Gravatar.astro";
import PostSeries from "@src/components/PostSeries.astro";
import RootLayout from "@src/layouts/RootLayout.astro";
import type { Link, PostContent } from "@src/types";
import { Icon } from "astro-icon/components";
import { SEO } from "astro-seo";
import { createExcerpt } from "@src/utils/excerpt";
import { getPostSeries } from "@src/utils/posts";

import config from "@src/config.ts";

interface Props {
    frontmatter: PostContent;
    slug?: string;
    file?: string;
}

const { frontmatter, slug, file } = Astro.props;
const { title, description, date, image, tags, links } = frontmatter;

const displayDate = date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const postDescription =
    description ??
    (await createExcerpt(await Astro.slots.render("default"))) ??
    config.description;

const currentSlug =
    slug ??
    file
        ?.split("/")
        .pop()
        ?.replace(/\.mdx$/, "") ??
    "";
const series = getPostSeries(currentSlug);
---

<RootLayout title={title}>
    <SEO slot="head"
        title={`${title} | ${config.title}`}
        description={postDescription}
        canonical={canonicalURL}
        openGraph={{
            basic: {
                title: title,
                type: "article",
                image: image?.src ?? `${new URL("/social.jpg", Astro.site).toString()}`,
            },
            optional: {
                description: postDescription,
            },
            article: {
                publishedTime: date.toISOString(),
                authors: [config.author.name],
                tags: tags,
            }
        }}
        twitter={{
            creator: `@${config.social.xcom}`,
            card: "summary_large_image",
            description: postDescription,
        }}
    />

    <main class="container mx-auto px-4 py-12 max-w-4xl">
        <article class="prose prose-lg lg:prose-xl mx-auto">
            <a href="/" class="btn btn-ghost btn-xs">
                <Icon name="heroicons:chevron-left" />
                Back
            </a>

            <header class="mx-auto py-8 px-4">
                <h1 class="text-4xl font-bold text-base-content mb-4 tracking-tight text-center md:text-left">
                    { title }
                </h1>

                <div class="flex flex-col md:flex-row items-center gap-y-3 text-sm text-neutral-content/70 border-t border-neutral/30 pt-6">
                    <div class="flex items-center gap-3">
                        <div class="avatar">
                            <div class="w-8 rounded-full ring ring-primary/20 ring-offset-base-100 ring-offset-2">
                                <Gravatar email={ config.author.email } />
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2">
                            <a href="/" target="_blank" class="link-primary font-semibold tracking-wide">
                                @{ config.author.name }
                            </a>

                            {date && (
                                <span class="hidden sm:inline opacity-30">/</span>
                                <time datetime={ date.toISOString() } class="opacity-60">
                                    { displayDate }
                                </time>
                            )}
                        </div>
                    </div>

                    <div class="grow"></div>

                    <nav class="flex flex-row items-center gap-5">
                        <a href={`https://x.com/${config.social.xcom}`} target="_blank" class="group flex items-center gap-1.5 hover:text-primary transition-all">
                            <span class="opacity-50 group-hover:opacity-100 transition-opacity">
                                <Icon name="fa7-brands:x-twitter" />
                            </span>
                        </a>

                        <a href={`https://github.com/${config.social.github}`} target="_blank" class="group flex items-center gap-1.5 hover:text-primary transition-all">
                            <span class="opacity-50 group-hover:opacity-100 transition-opacity">
                                <Icon name="fa7-brands:github" />
                            </span>
                        </a>

                        <a href={config.urls.support} target="_blank" class="group flex items-center gap-1.5 hover:text-primary transition-all">
                            <span class="opacity-50 group-hover:opacity-100 transition-opacity">
                                <Icon name="heroicons:heart" />
                            </span>
                        </a>
                    </nav>
                </div>
            </header>

            {tags && tags.length > 0 && (
                <div class="flex flex-row flex-wrap gap-2 justify-center mb-6">
                    {tags.map((tag: string) =>
                        <a href={`/tags/${tag}`} class="badge badge-lg badge-outline hover:badge-primary">
                            <Icon name="heroicons:hashtag" />
                            { tag }
                        </a>
                    )}
                </div>
            )}

            {image && (
                <figure class="mb-6">
                    <img class="w-full" src={ image.src } />

                    {image.caption && (
                        <figcaption class="text-center text-base-content/60 mt-3">
                            { image.caption }
                        </figcaption>
                    )}
                </figure>
            )}

            {series.hasSeries && (
                <PostSeries posts={series.posts} />
            )}

            <div class="blog-content">
                <slot />
            </div>

            {links && links.length > 0 && (
                <Fragment>
                    <h3 class="text-xl font-semibold mt-3 mb-3">Links</h3>

                    <ul class="list-disc ml-8 mb-8">
                        {links.map((link: Link) => (
                            <li>
                                <a href={link.url} class="link-primary">
                                    {link.name}
                                </a>
                            </li>
                        ))}
                    </ul>
                </Fragment>
            )}

            <Comments />
        </article>
    </main>

    <div class="fab">
        <button class="btn btn-primary btn-circle btn-outline btn-lg" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            <Icon name="heroicons:arrow-up" />
        </button>
    </div>
</RootLayout>
